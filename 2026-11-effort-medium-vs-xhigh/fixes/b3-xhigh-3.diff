+
+// trackedConn is a net.Conn that says the instant something closes it, so a test
+// can tell "the gate filed my socket" from "the gate closed it on me".
+type trackedConn struct {
+	net.Conn
+	once   sync.Once
+	closed chan struct{}
+}
+
+func newTrackedConn() *trackedConn {
+	a, b := net.Pipe()
+	_ = b // the far end of the pipe, unused; closing the near end must not error
+	return &trackedConn{Conn: a, closed: make(chan struct{})}
+}
+
+func (c *trackedConn) Close() error {
+	err := c.Conn.Close()
+	c.once.Do(func() { close(c.closed) })
+	return err
+}
+
+func (c *trackedConn) isClosed() bool {
+	select {
+	case <-c.closed:
+		return true
+	default:
+		return false
+	}
+}
+
+// A background dial that reaches the lane by HANDOFF — it queued behind a holder
+// that released while it waited — must be able to file its own socket, exactly
+// like a dial that took an idle lane outright. Before the fix, release()'s
+// handoff stamped the new holder's class but left the previous holder's filed
+// (already-closed) socket in st.conn, so noteConn found a lane that looked
+// "already notated" and closed the new dial's LIVE socket instead of filing it.
+// The read-ahead pass met that as a spurious transport error on a plane, took it
+// as a card strike, and lost the plane it had parked to resume (B3, 2026-11-20).
+// This pins the gate's own contract: a granted holder's socket survives noteConn.
+func TestHandedOffHolderFilesItsOwnSocket(t *testing.T) {
+	g := NewDialGate()
+	const host = "10.0.0.77:80"
+
+	// A takes the idle lane and files its socket.
+	relA, err := g.Acquire(context.Background(), host, ClassBackground)
+	if err != nil {
+		t.Fatalf("A acquire: %v", err)
+	}
+	connA := newTrackedConn()
+	g.noteConn(host, connA)
+
+	// B queues behind A, exactly as the pass's next plane does when the previous
+	// plane's socket is still being released on the transport's readLoop.
+	granted := make(chan struct{})
+	var relB func()
+	go func() {
+		r, err := g.Acquire(context.Background(), host, ClassBackground)
+		if err != nil {
+			t.Errorf("B acquire: %v", err)
+			close(granted)
+			return
+		}
+		relB = r
+		close(granted)
+	}()
+	// Wait until B is actually in the queue, so A's release is a handoff and not
+	// a return-to-idle followed by a fresh acquire.
+	for deadline := time.Now().Add(2 * time.Second); ; {
+		g.mu.Lock()
+		waiters := 0
+		if st := g.lanes[host]; st != nil {
+			waiters = len(st.waiters)
+		}
+		g.mu.Unlock()
+		if waiters > 0 {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("B never reached the wait queue")
+		}
+		runtime.Gosched()
+	}
+
+	// A releases; the lane hands straight off to B without idling.
+	relA()
+	<-granted
+	if relB == nil {
+		t.Fatal("B never got the lane")
+	}
+
+	// B files its own socket. This is the moment the bug closed a live dial.
+	connB := newTrackedConn()
+	g.noteConn(host, connB)
+	if connB.isClosed() {
+		t.Fatal("noteConn closed the handed-off holder's own socket instead of filing it")
+	}
+
+	// The filed socket is B's, not the stale A socket: Interrupt must cut B and
+	// leave nothing dangling. This also confirms noteConn registered connB.
+	if !g.Interrupt(host) {
+		t.Fatal("the handed-off background holder was not interruptible through its filed socket")
+	}
+	if !connB.isClosed() {
+		t.Fatal("Interrupt cut a stale socket, not the handed-off holder's live one")
+	}
+	relB()
+}
