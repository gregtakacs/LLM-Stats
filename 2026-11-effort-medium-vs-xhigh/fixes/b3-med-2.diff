 }
+
+// A handoff must file no socket: the outgoing holder's socket died with it, and
+// a stale filing reads to noteConn as "lane already noted", which CLOSES the
+// incoming holder's live socket before its request is ever written. B3
+// (docs/bugs.md): the read-ahead pass's second plane died mid-request with
+// "use of closed network connection" every time its dial queued behind the
+// first plane's async transport close — a self-inflicted cut the pass struck
+// as a card failure.
+func TestTheGateHandoffGrantsTheLaneWithNoSocketFiled(t *testing.T) {
+	g := NewDialGate()
+	const host = "10.0.0.9:80"
+	hold, err := g.Acquire(context.Background(), host, ClassBackground)
+	if err != nil {
+		t.Fatal(err)
+	}
+	c1r, c1w := net.Pipe()
+	defer c1r.Close()
+	c1 := &trackedConn{Conn: c1w}
+	g.noteConn(host, c1)
+
+	granted := make(chan func(), 1)
+	go func() {
+		rel, err := g.Acquire(context.Background(), host, ClassBackground)
+		if err != nil {
+			t.Errorf("the queued ticket failed: %v", err)
+			granted <- nil
+			return
+		}
+		granted <- rel
+	}()
+	// Force the handoff branch rather than hope for it: the second ticket is
+	// only granted by a release if it is already in the queue.
+	for deadline := time.Now().Add(2 * time.Second); ; time.Sleep(time.Millisecond) {
+		g.mu.Lock()
+		queued := len(g.lanes[host].waiters) == 1
+		g.mu.Unlock()
+		if queued {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("the second background ticket never queued")
+		}
+	}
+	// The real release order: the transport closes the socket, and the close is
+	// what frees the lane — so the handoff runs with the old socket already
+	// dead but still filed, exactly as the pass meets it.
+	c1.Close()
+	hold()
+	rel := <-granted
+	if rel == nil {
+		t.Fatal("the second ticket was not granted")
+	}
+	defer rel()
+
+	c2r, c2w := net.Pipe()
+	defer c2r.Close()
+	c2 := &trackedConn{Conn: c2w}
+	g.noteConn(host, c2)
+	if c2.wasClosed() {
+		t.Fatal("the handoff left the old holder's socket filed and noteConn closed the " +
+			"new holder's live socket: the next background dial dies mid-request (B3)")
+	}
+	if !g.Interrupt(host) {
+		t.Fatal("the new holder filed no socket: its dial is not interruptible")
+	}
+}
+
+// trackedConn remembers whether anything closed it, so a test can say whether
+// the gate filed a background holder's socket or rejected and killed it.
+type trackedConn struct {
+	net.Conn
+	closed atomic.Bool
+}
+
+func (c *trackedConn) Close() error {
+	c.closed.Store(true)
+	return c.Conn.Close()
+}
+
+func (c *trackedConn) wasClosed() bool { return c.closed.Load() }
