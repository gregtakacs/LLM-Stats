--- a/tools/{orb-tool}/internal/orbnet/lane.go
+++ b/tools/{orb-tool}/internal/orbnet/lane.go
@@ -349,7 +349,14 @@ func (g *DialGate) release(host string) {
 		// so a burst of control dials cannot leapfrog the ticket already next.
 		// The grant stamps the new holder's class: from this instant
 		// Interrupt may close this ticket's socket once the dialer files it.
+		// The outgoing holder's socket goes with it: it is closed — closing it
+		// is usually what ran this release — and filing it onto the new holder
+		// would make that holder's own noteConn see a lane already noted and
+		// close its fresh socket, killing the next background dial mid-request
+		// with a local socket error the pass would strike as a card failure
+		// (docs/bugs.md B3). The next socket files itself, at its own dial.
 		st.bg = w.class == ClassBackground
+		st.conn = nil
 		w.granted = true
 		close(w.ready)
 		return
