+// A handoff must hand over an empty socket slot. release() files nothing for
+// the new holder — noteConn does that when the dialer's socket opens — but if
+// the granting path leaves the PREVIOUS holder's filed socket in st.conn, the
+// new background holder's fresh socket is treated as a late note from a dead
+// ticket and closed out from under it: the warm pass's second plane then died
+// with "use of closed network connection" while the hub had cut nothing
+// (docs/bugs.md B3). Forced here without timing luck: hold, queue, hand off,
+// note, use.
+func TestHandoffGrantsALaneWithAnEmptySocketSlot(t *testing.T) {
+	g := NewDialGate()
+	const host = "10.0.0.31:80"
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ln.Close()
+	go func() { // every socket that reaches the listener answers one request
+		for {
+			c, aerr := ln.Accept()
+			if aerr != nil {
+				return
+			}
+			go func(c net.Conn) {
+				buf := make([]byte, 1)
+				_, _ = c.Read(buf)
+				_, _ = c.Write([]byte("ok"))
+				c.Close()
+			}(c)
+		}
+	}()
+
+	// The pass's first plane: a background holder with its socket filed.
+	release1, err := g.Acquire(context.Background(), host, ClassBackground)
+	if err != nil {
+		t.Fatal(err)
+	}
+	conn1, err := net.Dial("tcp", ln.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	g.noteConn(host, conn1)
+	if filed := filedConn(g, host); filed != conn1 {
+		t.Fatalf("a background holder's socket was not filed: %v", filed)
+	}
+
+	// The pass's second plane queues behind it, as the next loop leg does.
+	granted := make(chan func(), 1)
+	go func() {
+		release, err := g.Acquire(context.Background(), host, ClassBackground)
+		if err != nil {
+			t.Errorf("second background Acquire: %v", err)
+			granted <- nil
+			return
+		}
+		granted <- release
+	}()
+	if !waitFor(func() bool { return queuedCount(g, host) == 1 }, 2*time.Second) {
+		t.Fatal("the second ticket never joined the queue")
+	}
+
+	// The first plane's response drains and its transport closes the socket,
+	// laneConn-style: socket first, release second. That release finds the
+	// queued ticket and hands the lane over.
+	conn1.Close()
+	release1()
+	release2 := <-granted
+	if release2 == nil {
+		t.Fatal("the handoff never reached the queued ticket")
+	}
+	defer release2()
+
+	// The new holder dials and files, exactly as gatedDialer does.
+	conn2, err := net.Dial("tcp", ln.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn2.Close()
+	g.noteConn(host, conn2)
+	if filed := filedConn(g, host); filed != conn2 {
+		t.Fatalf("the granted holder's socket was not filed; the lane is still noting %v", filed)
+	}
+	// And the socket must still be usable — this is the call the warm pass
+	// makes on its second plane.
+	_ = conn2.SetReadDeadline(time.Now().Add(5 * time.Second))
+	if _, err := conn2.Write([]byte("g")); err != nil {
+		t.Fatalf("the filed socket died before it was used: %v", err)
+	}
+	reply := make([]byte, 2)
+	if _, err := io.ReadFull(conn2, reply); err != nil {
+		t.Fatalf("the granted holder's fresh socket was closed under it: %v", err)
+	}
+	if string(reply) != "ok" {
+		t.Fatalf("the socket answered %q, want ok", reply)
+	}
+}
+
+func filedConn(g *DialGate, host string) net.Conn {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	if st := g.lanes[host]; st != nil {
+		return st.conn
+	}
+	return nil
+}
+
+func queuedCount(g *DialGate, host string) int {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	if st := g.lanes[host]; st != nil {
+		return len(st.waiters)
+	}
+	return 0
+}
+
+// waitFor bounds a wait for a condition the gate will reach on its own (a
+// queued ticket appearing); it times out loudly rather than encoding a hope.
+func waitFor(cond func() bool, d time.Duration) bool {
+	deadline := time.Now().Add(d)
+	for {
+		if cond() {
+			return true
+		}
+		if time.Now().After(deadline) {
+			return false
+		}
+		time.Sleep(time.Millisecond)
+	}
+}
