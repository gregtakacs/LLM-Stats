+
+// The handoff must empty the departing holder's socket slot before it grants:
+// the release that hands off runs through that socket's own close (laneConn),
+// so its filing is dead at the instant of the grant, and noteConn files a
+// socket only into an empty slot. With the dead filing left in place, noteConn
+// treated the NEW background holder's live socket as a race loser and closed
+// it — the warm pass's second plane died with "use of closed network
+// connection" before the request was written, which is the shape the B3 flaky
+// queue-parking test kept hitting under load (every handoff — the next dial
+// arriving before the last one's transport close ran — was a coin flip).
+func TestDialGateHandoffFilesTheNewHoldersSocket(t *testing.T) {
+	g := NewDialGate()
+	const host = "10.0.0.7:80"
+
+	// One loopback pair per holder: noteConn files the client side, and a
+	// write on it proves whether the gate just closed it. (net.Pipe cannot
+	// stand in: its Write blocks until a reader takes the bytes.)
+	dialPair := func() net.Conn {
+		t.Helper()
+		ln, err := net.Listen("tcp", "127.0.0.1:0")
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer ln.Close()
+		accepted := make(chan net.Conn, 1)
+		go func() {
+			c, err := ln.Accept()
+			if err == nil {
+				accepted <- c
+			}
+		}()
+		conn, err := net.Dial("tcp", ln.Addr().String())
+		if err != nil {
+			t.Fatal(err)
+		}
+		t.Cleanup(func() {
+			conn.Close()
+			select {
+			case c := <-accepted:
+				c.Close()
+			default:
+			}
+		})
+		<-accepted
+		return conn
+	}
+
+	relA, err := g.Acquire(context.Background(), host, ClassBackground)
+	if err != nil {
+		t.Fatal(err)
+	}
+	sockA := dialPair()
+	g.noteConn(host, sockA) // A's dialer files its socket, as gatedDialer does
+
+	// B queues while A still holds — the exact position the warm pass's second
+	// plane sits in when it Acquires a heartbeat before A's transport close.
+	granted := make(chan func(), 1)
+	go func() {
+		relB, err := g.Acquire(context.Background(), host, ClassBackground)
+		if err != nil {
+			t.Errorf("B's queued Acquire: %v", err)
+			close(granted)
+			return
+		}
+		granted <- relB
+	}()
+	time.Sleep(20 * time.Millisecond) // let B's ticket enqueue
+
+	// A finishes: its socket closes and the release hands the lane to B.
+	sockA.Close()
+	relA()
+	relB, ok := <-granted
+	if !ok || relB == nil {
+		t.Fatal("B never got the handed-off lane")
+	}
+	defer relB()
+
+	// B files its own live socket. Without the handoff clearing A's dead
+	// filing, noteConn closes B's socket instead of registering it.
+	sockB := dialPair()
+	g.noteConn(host, sockB)
+	if _, err := sockB.Write([]byte("x")); err != nil {
+		t.Fatalf("noteConn killed the handed-off holder's fresh socket (%v): the departing holder's filing must leave the slot at the grant", err)
+	}
+	// The slot now names B's socket: the page's cut tool finds and closes it.
+	began := time.Now()
+	if !g.Interrupt(host) {
+		t.Fatal("Interrupt found nothing to cut though the handed-off holder filed its socket")
+	}
+	if !g.CutSince(host, began.Add(-time.Nanosecond)) {
+		t.Fatal("Interrupt cut the handed-off holder's socket and never stamped the cut")
+	}
+}
